{
  "excludes": [
    "**/.cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/__pycache__",
    ".basedpyright",
    ".claude",
    ".superpowers",
    ".venv",
    "out",
  ],
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/ruff@0.8.8",
    "npm:@dprint/toml@0.8.0",
  ],

  // Common formatting
  "indentWidth": 2,
  "lineWidth": 140,
  "newLineKind": "lf",
  "useTabs": false,

  "json": {
    "commentLine.forceSpaceAfterSlashes": true,
    "preferSingleLine": false,
  },
  "markdown": {
    "emphasisKind": "underscores",
    "lineWidth": 80,
    "strongKind": "asterisks",
    "textWrap": "always",
  },
  "ruff": {
    "indentWidth": 4, // Need to override the common formatting apparently
    "lineLength": 140, // Matches ruff.toml
  },
  "toml": {
    "associations": ["!**/pyproject.toml"],
    "indentWidth": 4,
  },
}
